rm -f FindTaintedCondition.so instrumented.ll instrumented.o \
      implicit_runtime.o test_dfsan

clang++ -std=c++17 -fPIC -shared 
    FindTaintedCondition.cpp \
    $(llvm-config --cxxflags --ldflags --system-libs --libs core passes) \
    -o FindTaintedCondition.so

clang -O0 -g -S -emit-llvm test.c -o test.ll


opt \
    -load-pass-plugin=./FindTaintedCondition.so \
    -passes="dfsan,implicit-taint" \
    -dfsan-conditional-callbacks \
    -dfsan-abilist=/usr/lib/llvm-21/lib/clang/21/share/dfsan_abilist.txt \
    test.ll \
    -S \
    -o instrumented.ll

opt \
    -passes=verify \
    instrumented.ll \
    -disable-output

clang -O0 -c implicit_runtime.c -o implicit_runtime.o

llc -O0 instrumented.ll \
    -filetype=obj \
    -o instrumented.o

clang \
    instrumented.o \
    implicit_runtime.o \
    -fsanitize=dataflow \
    -o test_dfsan

./test_dfsan
