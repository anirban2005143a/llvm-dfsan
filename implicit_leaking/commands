rm -f FindTaintedCondition.so \
      test.ll \
      instrumented.ll \
      instrumented.o \
      implicit_runtime.o \
      test_dfsan

clang++ -std=c++17 -fPIC -shared \
    FindTaintedCondition.cpp \
    $(llvm-config --cxxflags --ldflags --system-libs --libs core) \
    -o FindTaintedCondition.so

clang -O0 -g \
    -fsanitize=dataflow \
    -mllvm -dfsan-conditional-callbacks \
    -S -emit-llvm \
    test.c \
    -o test.ll


opt \
    -load-pass-plugin=./FindTaintedCondition.so \
    -passes=implicit-taint \
    test.ll \
    -S \
    -o instrumented.ll

clang -O0 -c \
    instrumented.ll \
    -o instrumented.o

clang -O0 -c \
    implicit_runtime.c \
    -o implicit_runtime.o

clang \
    -fsanitize=dataflow \
    instrumented.o \
    implicit_runtime.o \
    -o test_dfsan
    
./test_dfsan